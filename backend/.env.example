# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Database Configuration (Prisma Connection URL)
DATABASE_URL="mysql://orderflow_user:orderflow_password@localhost:3306/orderflow_dev"

# Redis Cache and Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets for Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_change_in_production_min32chars
JWT_REFRESH_EXPIRATION=7d

# Stripe Sandbox Configuration
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# CORS Security Settings
CORS_ORIGIN=http://localhost:3000

# Logging Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug
